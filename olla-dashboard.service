[Unit]
Description=Olla Dashboard
After=network-online.target olla.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/olla/dashboard
ExecStart=/opt/olla/dashboard/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
